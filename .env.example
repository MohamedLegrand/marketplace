# Copier en ".env" (non versionne) et renseigner les valeurs.
# Charge automatiquement par marketplace/settings.py via python-dotenv.

# --- Base de donnees ---
DB_NAME=marketplace_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Agregateur de paiement HR-Skills Pay ---
# Sans HRSKILLS_KEY_A : mode simulation local (montant pair -> SUCCESS).
HRSKILLS_BASE_URL=https://api.hrskills-pay.com
HRSKILLS_KEY_A=
HRSKILLS_KEY_B=
# Forcer la simulation meme avec des cles : HRSKILLS_MOCK=1
HRSKILLS_MOCK=
# Delai (min) avant de marquer echoue un paiement toujours en attente.
HRSKILLS_POLL_TIMEOUT_MIN=20
