# Variables d'environnement lues par marketplace/settings.py (bloc DATABASES).
# Des valeurs par defaut de developpement sont utilisees si elles sont absentes.
# A definir dans le shell avant de lancer le serveur, par exemple :
#   PowerShell : $env:DB_PASSWORD = "monMotDePasse"

DB_NAME=marketplace_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
