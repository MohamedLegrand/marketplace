# Copier en ".env" (non versionne) et renseigner les valeurs.
# Charge automatiquement par marketplace/settings.py via python-dotenv.

# --- Base de donnees ---
DB_NAME=marketplace_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Assistant IA d'analyse des ventes (Groq) ---
# Sans GROQ_API_KEY : reponses simulees (mode demonstration).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MOCK=
